OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
# Prompt window and answer cap for generation; a prompt over NUM_CTX is
# silently cut from the start, dropping the retrieved sources.
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=1024
# Per-request timeout; generation on CPU (Docker on macOS) can take minutes.
OLLAMA_TIMEOUT_SECONDS=120
# Must match the embedding model's output size (nomic-embed-text: 768).
EMBEDDING_DIM=768
LOG_LEVEL=INFO
DB_POOL_MAX_SIZE=5
# Chunk size in tokens and overlap share. Applies to new uploads only; raising
# CHUNK_TOKENS means raising OLLAMA_NUM_CTX too (top_k chunks fill the prompt).
CHUNK_TOKENS=300
CHUNK_OVERLAP_RATIO=0.15
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/findocbot
