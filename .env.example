OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# Window for embedding requests: Ollama otherwise loads the model at its
# maximum (qwen3-embedding: 32768 tokens, 5.8 GB; 2.9 GB at 8192). An input
# longer than this is refused, not cut (the document fails, a query gets a
# 400), so keep it above the longest chunk: Armenian reaches ~2,300 tokens
# at CHUNK_TOKENS=300, English ~650.
OLLAMA_EMBED_NUM_CTX=8192
# Optional reranker that reorders the vector-search candidates (empty = off).
# Pull it first, e.g. `ollama pull awenleven/Qwen3-Reranker-4B:Q4_K_M`, and see
# evals/README.md for how it compares with plain search before enabling it.
OLLAMA_RERANK_MODEL=
# Candidates handed to the reranker (never fewer than top_k), and the deadline
# for the whole rerank step; past it search keeps the vector order.
RERANK_CANDIDATES=20
RERANK_TIMEOUT_SECONDS=30
# Prompt window and answer cap for generation; a prompt over NUM_CTX is
# silently cut from the start, dropping the retrieved sources.
OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=1024
# Per-request timeout; generation on CPU (Docker on macOS) can take minutes.
OLLAMA_TIMEOUT_SECONDS=120
# Must match the embedding model's output size (qwen3-embedding:0.6b: 1024).
EMBEDDING_DIM=1024
LOG_LEVEL=INFO
DB_POOL_MAX_SIZE=5
# Chunk size in tokens and overlap share. Applies to new uploads only; raising
# CHUNK_TOKENS means raising OLLAMA_NUM_CTX too (top_k chunks fill the prompt).
# A chunk is also cut at ten characters per token (3,000 at 300), so text
# without spaces cannot make one far longer than the embedding window.
CHUNK_TOKENS=300
CHUNK_OVERLAP_RATIO=0.15
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/findocbot
